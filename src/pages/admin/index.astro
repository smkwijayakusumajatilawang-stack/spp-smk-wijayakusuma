---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Admin Dashboard">
	<header class="mb-6">
		<p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--brand)]">Administrator</p>
		<h2 class="text-2xl font-black sm:text-3xl">Dashboard Admin</h2>
		<p class="mt-1 text-sm text-slate-500">Panel kendali untuk mengelola sistem pembayaran SPP.</p>
	</header>

	<!-- Guard: hanya admin -->
	<div id="access-denied" class="hidden rounded-xl border border-red-200 bg-red-50 p-6 text-center">
		<p class="font-semibold text-red-700">Akses ditolak — halaman ini hanya untuk Administrator.</p>
		<a href="/" class="mt-3 inline-block text-sm text-red-600 underline">Kembali ke Dashboard</a>
	</div>

	<div id="page-content" class="hidden space-y-6">

		<!-- Stat Cards -->
		<section class="grid grid-cols-2 gap-4 md:grid-cols-4">
			<article class="rounded-xl border border-slate-200 p-4">
				<p class="text-xs uppercase tracking-[0.12em] text-slate-500">Total Pengguna</p>
				<p id="stat-users" class="mt-2 text-3xl font-black">-</p>
			</article>
			<article class="rounded-xl border border-slate-200 p-4">
				<p class="text-xs uppercase tracking-[0.12em] text-slate-500">Total Siswa</p>
				<p id="stat-students" class="mt-2 text-3xl font-black">-</p>
			</article>
			<article class="rounded-xl border border-slate-200 p-4">
				<p class="text-xs uppercase tracking-[0.12em] text-slate-500">Rekening Aktif</p>
				<p id="stat-accounts" class="mt-2 text-3xl font-black">-</p>
			</article>
			<article class="rounded-xl border border-slate-200 p-4">
				<p class="text-xs uppercase tracking-[0.12em] text-slate-500">Audit Log (7 Hari)</p>
				<p id="stat-audit" class="mt-2 text-3xl font-black">-</p>
			</article>
		</section>

		<!-- Quick Links -->
		<section>
			<h3 class="text-lg font-bold mb-3">Menu Administrator</h3>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<a href="/admin/pengguna"
					class="group rounded-xl border border-slate-200 p-5 transition hover:border-[var(--brand)] hover:shadow-md">
					<div class="flex items-center gap-3 mb-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
							</svg>
						</div>
						<h4 class="font-bold text-base">Kelola Pengguna</h4>
					</div>
					<p class="text-sm text-slate-500">Buat akun kasir/admin baru, ubah role, dan aktifkan/nonaktifkan pengguna.</p>
				</a>

				<a href="/admin/koreksi"
					class="group rounded-xl border border-slate-200 p-5 transition hover:border-[var(--brand)] hover:shadow-md">
					<div class="flex items-center gap-3 mb-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 text-amber-600 group-hover:bg-amber-600 group-hover:text-white transition">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
							</svg>
						</div>
						<h4 class="font-bold text-base">Koreksi Data</h4>
					</div>
					<p class="text-sm text-slate-500">Void pembayaran, koreksi nominal tagihan, dan lihat jejak audit sistem.</p>
				</a>

			<a href="/admin/rekening"
				class="group rounded-xl border border-slate-200 p-5 transition hover:border-[var(--brand)] hover:shadow-md">
				<div class="flex items-center gap-3 mb-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/>
							<path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/>
						</svg>
					</div>
					<h4 class="font-bold text-base">Rekening Bank</h4>
				</div>
				<p class="text-sm text-slate-500">Kelola rekening bank yayasan yang ditampilkan saat proses pembayaran.</p>
			</a>

			<a href="/admin/ganti-password"
				class="group rounded-xl border border-slate-200 p-5 transition hover:border-[var(--brand)] hover:shadow-md">
				<div class="flex items-center gap-3 mb-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-rose-100 text-rose-600 group-hover:bg-rose-600 group-hover:text-white transition">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
						</svg>
					</div>
					<h4 class="font-bold text-base">Ganti Password</h4>
				</div>
				<p class="text-sm text-slate-500">Atur ulang password pengguna sistem. Semua perubahan tercatat di audit log.</p>
			</a>
		</div>
	</section>

		<!-- Aktivitas Terbaru -->
		<section class="rounded-xl border border-slate-200 p-4">
			<div class="flex items-center justify-between mb-3">
				<h3 class="text-lg font-bold">Aktivitas Terbaru</h3>
				<a href="/admin/koreksi" class="text-sm font-semibold text-[var(--brand)] hover:underline">Lihat semua →</a>
			</div>
			<div class="overflow-x-auto">
				<table class="min-w-full text-sm">
					<thead class="border-b bg-slate-50 text-left text-xs uppercase text-slate-500">
						<tr>
							<th class="px-3 py-2">Waktu</th>
							<th class="px-3 py-2">Pengguna</th>
							<th class="px-3 py-2">Aksi</th>
							<th class="px-3 py-2">Keterangan</th>
						</tr>
					</thead>
					<tbody id="audit-body">
						<tr><td class="px-3 py-3 text-slate-400" colspan="4">Memuat data...</td></tr>
					</tbody>
				</table>
			</div>
		</section>

		<!-- Pengguna Terdaftar -->
		<section class="rounded-xl border border-slate-200 p-4">
			<div class="flex items-center justify-between mb-3">
				<h3 class="text-lg font-bold">Pengguna Sistem</h3>
				<a href="/admin/pengguna" class="text-sm font-semibold text-[var(--brand)] hover:underline">Kelola pengguna →</a>
			</div>
			<div class="overflow-x-auto">
				<table class="min-w-full text-sm">
					<thead class="border-b bg-slate-50 text-left text-xs uppercase text-slate-500">
						<tr>
							<th class="px-3 py-2">Nama</th>
							<th class="px-3 py-2">Email</th>
							<th class="px-3 py-2">Role</th>
							<th class="px-3 py-2">Status</th>
						</tr>
					</thead>
					<tbody id="users-body">
						<tr><td class="px-3 py-3 text-slate-400" colspan="4">Memuat data...</td></tr>
					</tbody>
				</table>
			</div>
		</section>
	</div>

	<script>
		import { createClient } from "@supabase/supabase-js";

		const supabase = createClient(
			import.meta.env.PUBLIC_SUPABASE_URL,
			import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
		);

		// ─── Role guard ────────────────────────────────────────────────────────
		const { data: { session } } = await supabase.auth.getSession();
		if (!session) { window.location.href = "/login"; throw new Error(); }

		const { data: profile } = await supabase
			.from("user_profiles").select("role").eq("user_id", session.user.id).single();

		if (profile?.role !== "admin") {
			document.getElementById("access-denied")?.classList.remove("hidden");
			throw new Error("Access denied");
		}
		document.getElementById("page-content")?.classList.remove("hidden");

		// ─── Helpers ──────────────────────────────────────────────────────────
		const ACTION_LABEL: Record<string, string> = {
			void_payment: "Void Pembayaran",
			edit_invoice: "Koreksi Tagihan",
			change_role: "Ubah Role",
			create_user: "Buat Pengguna",
		};

		const ROLE_BADGE: Record<string, string> = {
			admin: "bg-yellow-100 text-yellow-800",
			kasir: "bg-teal-100 text-teal-700",
		};

		// ─── Load stats ───────────────────────────────────────────────────────
		async function loadStats() {
			const sevenDaysAgo = new Date();
			sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
			const since = sevenDaysAgo.toISOString();

			const [usersRes, studentsRes, accountsRes, auditRes] = await Promise.all([
				supabase.from("user_profiles").select("id", { count: "exact", head: true }),
				supabase.from("students").select("id", { count: "exact", head: true }),
				supabase.from("bank_accounts").select("id", { count: "exact", head: true }).eq("is_active", true),
				supabase.from("audit_logs").select("id", { count: "exact", head: true }).gte("created_at", since),
			]);

			document.getElementById("stat-users")!.textContent = String(usersRes.count ?? 0);
			document.getElementById("stat-students")!.textContent = String(studentsRes.count ?? 0);
			document.getElementById("stat-accounts")!.textContent = String(accountsRes.count ?? 0);
			document.getElementById("stat-audit")!.textContent = String(auditRes.count ?? 0);
		}

		// ─── Load audit logs ──────────────────────────────────────────────────
		async function loadAuditLogs() {
			const body = document.getElementById("audit-body")!;
			const { data, error } = await supabase
				.from("audit_logs")
				.select("*")
				.order("created_at", { ascending: false })
				.limit(10);

			if (error) {
				body.innerHTML = `<tr><td class="px-3 py-3 text-red-600" colspan="4">${error.message}</td></tr>`;
				return;
			}

			if (!data?.length) {
				body.innerHTML = `<tr><td class="px-3 py-3 text-slate-400" colspan="4">Belum ada aktivitas.</td></tr>`;
				return;
			}

			body.innerHTML = data.map((log) => {
				const dt = new Date(log.created_at);
				const dateStr = dt.toLocaleDateString("id-ID") + " " + dt.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });
				const actionLabel = ACTION_LABEL[log.action] ?? log.action;
				return `<tr class="border-b">
					<td class="px-3 py-2 text-xs text-slate-500 whitespace-nowrap">${dateStr}</td>
					<td class="px-3 py-2 text-xs">${log.user_email ?? "-"}</td>
					<td class="px-3 py-2">
						<span class="rounded-full px-2 py-0.5 text-xs font-medium bg-slate-100 text-slate-700">${actionLabel}</span>
					</td>
					<td class="px-3 py-2 text-xs text-slate-600">${log.notes ?? "-"}</td>
				</tr>`;
			}).join("");
		}

		// ─── Load users list ──────────────────────────────────────────────────
		async function loadUsers() {
			const body = document.getElementById("users-body")!;
			const { data, error } = await supabase
				.from("user_profiles")
				.select("full_name,email,role,is_active")
				.order("created_at", { ascending: false })
				.limit(10);

			if (error) {
				body.innerHTML = `<tr><td class="px-3 py-3 text-red-600" colspan="4">${error.message}</td></tr>`;
				return;
			}

			if (!data?.length) {
				body.innerHTML = `<tr><td class="px-3 py-3 text-slate-400" colspan="4">Belum ada pengguna.</td></tr>`;
				return;
			}

			body.innerHTML = data.map((u) => {
				const roleBadge = ROLE_BADGE[u.role] ?? "bg-slate-100 text-slate-600";
				return `<tr class="border-b ${!u.is_active ? "opacity-50" : ""}">
					<td class="px-3 py-2 font-medium">${u.full_name || "-"}</td>
					<td class="px-3 py-2 text-slate-600">${u.email}</td>
					<td class="px-3 py-2">
						<span class="rounded-full px-2 py-0.5 text-xs font-semibold ${roleBadge}">${u.role === "admin" ? "Administrator" : "Kasir"}</span>
					</td>
					<td class="px-3 py-2">
						<span class="rounded-full px-2 py-0.5 text-xs font-medium ${u.is_active ? "bg-green-100 text-green-700" : "bg-red-100 text-red-600"}">
							${u.is_active ? "Aktif" : "Nonaktif"}
						</span>
					</td>
				</tr>`;
			}).join("");
		}

		// ─── Init ─────────────────────────────────────────────────────────────
		await Promise.all([loadStats(), loadAuditLogs(), loadUsers()]);
	</script>
</AppLayout>