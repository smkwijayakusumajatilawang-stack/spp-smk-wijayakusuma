---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Ganti Password">
	<header class="mb-6">
		<p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--brand)]">Administrator</p>
		<h2 class="text-2xl font-black sm:text-3xl">Ganti Password Pengguna</h2>
		<p class="mt-1 text-sm text-slate-500">Atur ulang password pengguna sistem.</p>
	</header>

	<!-- Guard: hanya admin -->
	<div id="access-denied" class="hidden rounded-xl border border-red-200 bg-red-50 p-6 text-center">
		<p class="font-semibold text-red-700">Akses ditolak — halaman ini hanya untuk Administrator.</p>
		<a href="/" class="mt-3 inline-block text-sm text-red-600 underline">Kembali ke Dashboard</a>
	</div>

	<div id="page-content" class="hidden">
		<section class="grid gap-4 lg:grid-cols-[420px_1fr]">

			<!-- Form Ganti Password -->
			<form id="pw-form" class="rounded-xl border border-slate-200 p-5">
				<h3 class="text-lg font-bold">Reset Password</h3>
				<div class="mt-4 space-y-3">
					<div>
						<label class="block text-xs text-slate-500 mb-1">Pilih Pengguna</label>
						<select id="f-user" required class="w-full rounded-lg border border-slate-300 px-3 py-2 bg-white">
							<option value="">-- Pilih pengguna --</option>
						</select>
					</div>
					<div>
						<label class="block text-xs text-slate-500 mb-1">Password Baru</label>
						<div class="relative">
							<input id="f-password" type="password" required minlength="8" placeholder="Min. 8 karakter"
								class="w-full rounded-lg border border-slate-300 px-3 py-2 pr-10" />
							<button type="button" id="toggle-pw"
								class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-400 hover:text-slate-600">
								<svg id="eye-open" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
									<path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
									<path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
								</svg>
								<svg id="eye-closed" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd" />
									<path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.064 7 9.542 7 .847 0 1.669-.105 2.454-.303z" />
								</svg>
							</button>
						</div>
					</div>
					<div>
						<label class="block text-xs text-slate-500 mb-1">Konfirmasi Password Baru</label>
						<input id="f-password-confirm" type="password" required minlength="8" placeholder="Ketik ulang password"
							class="w-full rounded-lg border border-slate-300 px-3 py-2" />
					</div>
				</div>
				<div id="form-error" class="hidden mt-3 rounded-lg bg-red-50 border border-red-200 px-3 py-2 text-sm text-red-700"></div>
				<div id="form-success" class="hidden mt-3 rounded-lg bg-green-50 border border-green-200 px-3 py-2 text-sm text-green-700"></div>
				<button type="submit" id="btn-submit"
					class="mt-4 w-full rounded-lg bg-[var(--brand)] px-4 py-2.5 font-bold text-white hover:bg-teal-700 disabled:opacity-40 disabled:cursor-not-allowed transition">
					Ganti Password
				</button>
			</form>

			<!-- Daftar Pengguna (referensi) -->
			<div class="rounded-xl border border-slate-200 p-4">
				<div class="flex items-center justify-between mb-3">
					<h3 class="text-lg font-bold">Daftar Pengguna</h3>
					<a href="/admin/pengguna" class="text-sm font-semibold text-[var(--brand)] hover:underline">Kelola pengguna →</a>
				</div>
				<div class="overflow-x-auto">
					<table class="min-w-full text-sm">
						<thead class="border-b bg-slate-50 text-left text-xs uppercase text-slate-500">
							<tr>
								<th class="px-3 py-2">Nama</th>
								<th class="px-3 py-2">Email</th>
								<th class="px-3 py-2">Role</th>
								<th class="px-3 py-2">Aksi</th>
							</tr>
						</thead>
						<tbody id="users-body">
							<tr><td class="px-3 py-3 text-slate-400" colspan="4">Memuat data...</td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- Info -->
		<div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4">
			<div class="flex gap-3">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-amber-600 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
				</svg>
				<div>
					<p class="text-sm font-semibold text-amber-800">Informasi</p>
					<p class="mt-1 text-sm text-amber-700">Password baru akan langsung berlaku. Pengguna yang bersangkutan akan diminta login ulang dengan password baru. Semua perubahan tercatat di audit log.</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		import { createClient } from "@supabase/supabase-js";

		const supabase = createClient(
			import.meta.env.PUBLIC_SUPABASE_URL,
			import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
		);

		// ─── Role guard ────────────────────────────────────────────────────────
		async function checkAdmin() {
			const { data: { session } } = await supabase.auth.getSession();
			if (!session) { window.location.href = "/login"; return null; }
			const { data: profile } = await supabase
				.from("user_profiles").select("role").eq("user_id", session.user.id).single();
			if (profile?.role !== "admin") {
				document.getElementById("access-denied")?.classList.remove("hidden");
				return null;
			}
			document.getElementById("page-content")?.classList.remove("hidden");
			return session;
		}

		const session = (await checkAdmin())!;
		if (!session) throw new Error("Access denied");

		// ─── Elements ──────────────────────────────────────────────────────────
		const userSelect = document.getElementById("f-user") as HTMLSelectElement;
		const pwInput = document.getElementById("f-password") as HTMLInputElement;
		const pwConfirmInput = document.getElementById("f-password-confirm") as HTMLInputElement;
		const form = document.getElementById("pw-form") as HTMLFormElement;
		const formError = document.getElementById("form-error")!;
		const formSuccess = document.getElementById("form-success")!;
		const btnSubmit = document.getElementById("btn-submit") as HTMLButtonElement;
		const usersBody = document.getElementById("users-body")!;
		const togglePw = document.getElementById("toggle-pw") as HTMLButtonElement;
		const eyeOpen = document.getElementById("eye-open")!;
		const eyeClosed = document.getElementById("eye-closed")!;

		// Toggle password visibility
		togglePw.addEventListener("click", () => {
			const isHidden = pwInput.type === "password";
			pwInput.type = isHidden ? "text" : "password";
			eyeOpen.classList.toggle("hidden", isHidden);
			eyeClosed.classList.toggle("hidden", !isHidden);
		});

		// ─── Load users ───────────────────────────────────────────────────────
		let usersList: Array<{ user_id: string; email: string; full_name: string; role: string; is_active: boolean }> = [];

		async function loadUsers() {
			const { data, error } = await supabase
				.from("user_profiles")
				.select("user_id, email, full_name, role, is_active")
				.order("full_name", { ascending: true });

			if (error) {
				usersBody.innerHTML = `<tr><td class="px-3 py-3 text-red-600" colspan="4">${error.message}</td></tr>`;
				return;
			}

			usersList = data || [];

			// Populate select
			userSelect.innerHTML = '<option value="">-- Pilih pengguna --</option>';
			usersList.forEach((u) => {
				const opt = document.createElement("option");
				opt.value = u.user_id;
				opt.textContent = `${u.full_name || u.email} (${u.email})`;
				userSelect.appendChild(opt);
			});

			// Render table
			const ROLE_BADGE: Record<string, string> = {
				admin: "bg-yellow-100 text-yellow-800",
				kasir: "bg-teal-100 text-teal-700",
			};

			if (!usersList.length) {
				usersBody.innerHTML = `<tr><td class="px-3 py-3 text-slate-400" colspan="4">Belum ada pengguna.</td></tr>`;
				return;
			}

			usersBody.innerHTML = usersList.map((u) => {
				const roleBadge = ROLE_BADGE[u.role] ?? "bg-slate-100 text-slate-600";
				const isSelf = u.user_id === session.user.id;
				return `<tr class="border-b ${!u.is_active ? "opacity-50" : ""}">
					<td class="px-3 py-2 font-medium">${u.full_name || "-"}${isSelf ? ' <span class="text-xs text-slate-400">(Anda)</span>' : ""}</td>
					<td class="px-3 py-2 text-slate-600">${u.email}</td>
					<td class="px-3 py-2">
						<span class="rounded-full px-2 py-0.5 text-xs font-semibold ${roleBadge}">${u.role === "admin" ? "Administrator" : "Kasir"}</span>
					</td>
					<td class="px-3 py-2">
						<button data-uid="${u.user_id}" data-name="${u.full_name || u.email}" class="text-[var(--brand)] hover:underline text-xs font-semibold btn-select-user">
							Pilih
						</button>
					</td>
				</tr>`;
			}).join("");
		}

		// Quick select from table
		usersBody.addEventListener("click", (e) => {
			const btn = (e.target as HTMLElement).closest("button[data-uid]") as HTMLButtonElement | null;
			if (!btn) return;
			userSelect.value = btn.dataset.uid!;
			userSelect.scrollIntoView({ behavior: "smooth", block: "center" });
			userSelect.focus();
		});

		// ─── Submit ────────────────────────────────────────────────────────────
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			formError.classList.add("hidden");
			formSuccess.classList.add("hidden");

			const targetUserId = userSelect.value;
			const newPassword = pwInput.value;
			const confirmPassword = pwConfirmInput.value;

			// Validasi
			if (!targetUserId) {
				formError.textContent = "Pilih pengguna terlebih dahulu.";
				formError.classList.remove("hidden");
				return;
			}
			if (newPassword.length < 8) {
				formError.textContent = "Password minimal 8 karakter.";
				formError.classList.remove("hidden");
				return;
			}
			if (newPassword !== confirmPassword) {
				formError.textContent = "Konfirmasi password tidak cocok.";
				formError.classList.remove("hidden");
				return;
			}

			btnSubmit.disabled = true;
			btnSubmit.textContent = "Memproses...";

			try {
				const res = await fetch("/api/admin/change-password", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						"Authorization": `Bearer ${session.access_token}`,
					},
					body: JSON.stringify({
						target_user_id: targetUserId,
						new_password: newPassword,
					}),
				});

				const result = await res.json();
				if (!res.ok) {
					formError.textContent = result.error || "Gagal mengganti password.";
					formError.classList.remove("hidden");
				} else {
					const selectedUser = usersList.find((u) => u.user_id === targetUserId);
					formSuccess.textContent = result.message || `Password ${selectedUser?.full_name || selectedUser?.email || "pengguna"} berhasil diganti.`;
					formSuccess.classList.remove("hidden");
					form.reset();
				}
			} catch (err: any) {
				formError.textContent = err.message || "Terjadi kesalahan.";
				formError.classList.remove("hidden");
			} finally {
				btnSubmit.disabled = false;
				btnSubmit.textContent = "Ganti Password";
			}
		});

		await loadUsers();
	</script>
</AppLayout>