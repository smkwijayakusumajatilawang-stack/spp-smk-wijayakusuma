---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Kartu SPP">
  <header class="mb-6">
    <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--brand)]">Laporan</p>
    <h2 class="text-2xl font-black sm:text-3xl">Kartu SPP</h2>
    <p class="mt-1 text-sm text-slate-500">
      Lihat riwayat pembayaran per siswa dalam format kartu SPP.
    </p>
  </header>

  <!-- Cari Siswa -->
  <div class="mb-4 flex flex-wrap gap-3 rounded-xl border border-slate-200 p-4 items-end">
    <div class="min-w-[250px]">
      <label class="block text-xs font-semibold text-slate-500 mb-1">Cari Siswa (Nama / NIS)</label>
      <input
        type="text"
        id="f-search"
        placeholder="Ketik nama atau NIS..."
        class="w-full rounded-lg border border-slate-300 px-3 py-2"
      />
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-500 mb-1">Tahun Ajaran</label>
      <select id="f-year" class="rounded-lg border border-slate-300 px-3 py-2 bg-white">
        <option value="">Semua</option>
      </select>
    </div>
    <button id="btn-search" class="rounded-lg bg-[var(--brand)] px-4 py-2 font-semibold text-white">
      🔍 Cari
    </button>
  </div>

  <!-- Hasil pencarian siswa -->
  <div id="search-results" class="mb-4 hidden rounded-xl border border-slate-200 p-4">
    <h3 class="font-bold text-sm text-slate-500 mb-2">HASIL PENCARIAN</h3>
    <div id="student-list" class="space-y-1 max-h-64 overflow-y-auto"></div>
  </div>

  <!-- Kartu SPP -->
  <div id="kartu-spp-container">
    <div class="rounded-xl border border-slate-200 p-8 text-center">
      <p class="text-slate-400">Cari siswa untuk menampilkan kartu SPP.</p>
    </div>
  </div>

  <script>
    import { createClient } from "@supabase/supabase-js";

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    );

    const fSearch = document.getElementById("f-search") as HTMLInputElement;
    const fYear = document.getElementById("f-year") as HTMLSelectElement;
    const btnSearch = document.getElementById("btn-search") as HTMLButtonElement;
    const searchResults = document.getElementById("search-results") as HTMLDivElement;
    const studentList = document.getElementById("student-list") as HTMLDivElement;
    const kartuContainer = document.getElementById("kartu-spp-container") as HTMLDivElement;

    const formatRupiah = (val: number) =>
      new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(val);

    const formatDate = (d: string | null) => {
      if (!d) return "-";
      return new Date(d).toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" });
    };

    // Load tahun ajaran
    async function loadYears() {
      const { data } = await supabase.from("academic_years").select("id,name,is_active").order("name");
      if (!data?.length) return;
      fYear.innerHTML = '<option value="">Semua</option>' +
        data.map(y => `<option value="${y.id}">${y.name}${y.is_active ? " (aktif)" : ""}</option>`).join("");
      const active = data.find(y => y.is_active);
      if (active) fYear.value = active.id;
    }

    async function searchStudent() {
      const q = fSearch.value.trim();
      if (!q) {
        searchResults.classList.add("hidden");
        return;
      }

      btnSearch.disabled = true;
      btnSearch.textContent = "⏳ Mencari...";

      let query = supabase
        .from("students")
        .select("id,name,nis,class_id,classes(name,angkatan,academic_year_id)")
        .or(`name.ilike.%${q}%,nis.ilike.%${q}%`)
        .limit(20);

      if (fYear.value) {
        query = query.eq("classes.academic_year_id", fYear.value);
      }

      const { data, error } = await query;

      if (error || !data?.length) {
        studentList.innerHTML = '<p class="text-sm text-slate-400 px-2 py-2">Siswa tidak ditemukan.</p>';
        searchResults.classList.remove("hidden");
        btnSearch.disabled = false;
        btnSearch.textContent = "🔍 Cari";
        return;
      }

      studentList.innerHTML = data.map(s => `
        <button
          data-id="${s.id}"
          class="student-item w-full text-left px-3 py-2 rounded-lg hover:bg-slate-50 border border-transparent hover:border-slate-200 transition"
        >
          <span class="font-medium">${s.name}</span>
          <span class="text-xs text-slate-400 ml-2">${s.nis ?? "NIS: -"}</span>
          <span class="text-xs text-slate-400 ml-2">${(s as any).classes?.name ?? "-"}</span>
          ${(s as any).classes?.angkatan ? `<span class="ml-1 rounded-full bg-blue-100 px-1.5 py-0.5 text-[10px] text-blue-600">Angk. ${(s as any).classes.angkatan}</span>` : ""}
        </button>
      `).join("");

      searchResults.classList.remove("hidden");
      btnSearch.disabled = false;
      btnSearch.textContent = "🔍 Cari";
    }

    async function loadKartuSPP(studentId: string, studentName: string, studentNis: string, className: string, angkatan: string) {
      kartuContainer.innerHTML = '<div class="rounded-xl border border-slate-200 p-8 text-center"><p class="text-slate-400">Memuat kartu SPP...</p></div>';

      // Ambil invoices
      const { data: invoices, error } = await supabase
        .from("invoices")
        .select(`
          id, total_amount, paid_amount, status, created_at, paid_off_at,
          component_id, components(name, payment_type),
          period_id, billing_periods(name, code, start_date, end_date)
        `)
        .eq("student_id", studentId)
        .neq("status", "cancelled")
        .order("created_at", { ascending: false });

      if (error) {
        kartuContainer.innerHTML = `<div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-600 text-sm"><p>Error: ${error.message}</p></div>`;
        return;
      }

      if (!invoices?.length) {
        kartuContainer.innerHTML = `
          <div class="rounded-xl border border-slate-200 p-8 text-center text-slate-400">
            <p class="mb-1 text-lg font-bold text-slate-600">${studentName}</p>
            <p>Belum memiliki tagihan.</p>
          </div>`;
        return;
      }

      // Aggregate
      const totalTagihan = invoices.reduce((sum, inv) => sum + Number(inv.total_amount), 0);
      const totalPaid = invoices.reduce((sum, inv) => sum + Number(inv.paid_amount), 0);
      const totalDue = totalTagihan - totalPaid;
      const isLunas = totalDue <= 0;

      let html = `
      <div class="rounded-xl border-2 ${isLunas ? 'border-green-300' : 'border-red-300'} p-6 bg-white">
        <!-- Header Kartu -->
        <div class="flex flex-wrap items-start justify-between border-b pb-4 mb-4">
          <div>
            <h2 class="text-xl font-black text-slate-800">KARTU SPP</h2>
            <p class="text-xs text-slate-500">SMK Wijayakusuma Jatilawang</p>
          </div>
          <div class="text-right">
            <div class="text-xs text-slate-400">Status</div>
            <div class="mt-1">
              ${isLunas
                ? '<span class="rounded-full bg-green-100 px-3 py-1 text-sm font-bold text-green-700">LUNAS</span>'
                : '<span class="rounded-full bg-red-100 px-3 py-1 text-sm font-bold text-red-700">MENUNGGAK</span>'}
            </div>
          </div>
        </div>

        <!-- Info Siswa -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4 text-sm">
          <div>
            <span class="text-xs text-slate-400 block">Nama Siswa</span>
            <span class="font-semibold">${studentName}</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">NIS</span>
            <span class="font-semibold">${studentNis ?? "-"}</span>
          </div>
          <div>
            <span class="text-xs text-slate-400 block">Kelas</span>
            <span class="font-semibold">${className} ${angkatan ? "(Angk. " + angkatan + ")" : ""}</span>
          </div>
        </div>

        <!-- Summary -->
        <div class="grid grid-cols-3 gap-2 mb-4 rounded-lg bg-slate-50 p-3 text-center text-sm">
          <div>
            <span class="block text-xs text-slate-400">Total Tagihan</span>
            <span class="font-bold text-slate-700">${formatRupiah(totalTagihan)}</span>
          </div>
          <div>
            <span class="block text-xs text-slate-400">Sudah Dibayar</span>
            <span class="font-bold text-green-600">${formatRupiah(totalPaid)}</span>
          </div>
          <div>
            <span class="block text-xs text-slate-400">Sisa</span>
            <span class="font-bold ${totalDue > 0 ? 'text-red-600' : 'text-green-600'}">${formatRupiah(totalDue)}</span>
          </div>
        </div>

        <!-- Tabel Rincian -->
        <div class="overflow-x-auto">
          <table class="min-w-full text-xs border-collapse">
            <thead class="border-b bg-slate-50 text-left">
              <tr>
                <th class="px-2 py-1.5">Komponen</th>
                <th class="px-2 py-1.5">Periode</th>
                <th class="px-2 py-1.5 text-right">Tagihan</th>
                <th class="px-2 py-1.5 text-right">Dibayar</th>
                <th class="px-2 py-1.5 text-right">Sisa</th>
                <th class="px-2 py-1.5 text-center">Status</th>
                <th class="px-2 py-1.5">Tgl Lunas</th>
              </tr>
            </thead>
            <tbody>`;

      invoices.forEach((inv, i) => {
        const comp = (inv as any).components;
        const period = (inv as any).billing_periods;
        const total = Number(inv.total_amount);
        const paid = Number(inv.paid_amount);
        const due = total - paid;
        const bg = i % 2 === 0 ? "" : "bg-slate-50/50";

        html += `<tr class="border-b ${bg}">
          <td class="px-2 py-1.5 font-medium">${comp?.name ?? "-"}</td>
          <td class="px-2 py-1.5 text-slate-500">${period?.name ?? "-"} (${period?.code ?? "-"})</td>
          <td class="px-2 py-1.5 text-right">${formatRupiah(total)}</td>
          <td class="px-2 py-1.5 text-right text-green-600">${formatRupiah(paid)}</td>
          <td class="px-2 py-1.5 text-right ${due > 0 ? 'text-red-500 font-semibold' : 'text-green-500'}">${formatRupiah(due)}</td>
          <td class="px-2 py-1.5 text-center">
            ${inv.status === 'paid'
              ? '<span class="rounded-full bg-green-100 px-1.5 py-0.5 text-[10px] text-green-700 font-semibold">Lunas</span>'
              : inv.status === 'posted'
                ? '<span class="rounded-full bg-yellow-100 px-1.5 py-0.5 text-[10px] text-yellow-700">Posted</span>'
                : '<span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-500">Draft</span>'}
          </td>
          <td class="px-2 py-1.5 text-slate-400">${formatDate(inv.paid_off_at)}</td>
        </tr>`;
      });

      html += `</tbody></table></div>

        <!-- Footer Kartu -->
        <div class="mt-4 border-t pt-3 text-[10px] text-slate-400 flex justify-between">
          <span>Dicetak: ${new Date().toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" })}</span>
          <span>SPP SMK Wijayakusuma</span>
        </div>
      </div>`;

      kartuContainer.innerHTML = html;
    }

    // Events
    btnSearch.addEventListener("click", searchStudent);
    fSearch.addEventListener("keydown", (e) => {
      if (e.key === "Enter") searchStudent();
    });

    studentList.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".student-item") as HTMLElement;
      if (!btn) return;
      const id = btn.dataset.id!;
      const name = btn.querySelector("span:first-of-type")?.textContent?.trim() || "";
      const nis = btn.querySelector("span:nth-of-type(2)")?.textContent?.trim() || "";
      const className = btn.querySelector("span:nth-of-type(3)")?.textContent?.trim() || "";
      const angkatanMatch = btn.textContent?.match(/Angk\.\s*(\d+)/);
      const angkatan = angkatanMatch ? angkatanMatch[1] : "";
      loadKartuSPP(id, name, nis, className, angkatan);
    });

    // Init
    await loadYears();
  </script>
</AppLayout>